{
  "manifest_version": 3,
  "name": "DailyLogs 网页媒体采集",
  "version": "0.1.0",
  "description": "把当前网页里的图片、视频、音频一键发送到 DailyLogs 工作区。",
  "permissions": ["activeTab", "scripting", "storage", "webRequest", "tabs", "alarms", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "发送到 DailyLogs",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "打开 DailyLogs 媒体采集面板" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
